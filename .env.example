# Supply the real token only in your private .env (Docker) or environment.
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DATABASE_PATH=/data/bot.sqlite3
CONFIG_PATH=/app/config.json
LOG_LEVEL=INFO
BACKUP_DIR=/data/backups
# Optional directory mounted from an independent backup destination:
# OFFSITE_BACKUP_DIR=/offsite

# Optional combined Jita + Perimeter market reports. Values below override JSON.
# config.example.json keeps reports disabled until you set your own channel ID.
# Existing configurations without market settings remain disabled by default.
# MARKET_REPORT_ENABLED=true
# MARKET_CHANNEL_ID=YOUR_MARKET_CHANNEL_ID
# MARKET_INTERVAL_MINUTES=60
# MARKET_REGION_ID=10000002
# JITA_LOCATION_ID=60003760
# PERIMETER_SYSTEM_ID=30000144
# DATACASTER_MIN_BUY_PRICE=500000
# DATACASTER_LOW_DEPTH_UNITS=5000
# MARKET_REQUEST_TIMEOUT_SECONDS=20
